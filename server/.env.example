# Environment configuration for Happy Song Local Backend Server
PORT=3000
NODE_ENV=development

# PostgreSQL Local Connection Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=happy_song_pos

# Railway Cloud Secondary Sync Configuration (Optional for local-only testing)
RAILWAY_PG_URL=
SYNC_INTERVAL_MS=30000

# Temporary Owner Mirror Cloud Snapshot
# Local PC server:
# OWNER_MIRROR_CLOUD_URL=https://your-railway-app.up.railway.app/exec
# OWNER_MIRROR_TOKEN=change-this-secret
# OWNER_MIRROR_SOURCE_ID=happy-song-local
#
# Railway app service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# OWNER_MIRROR_MODE=cloud
# OWNER_MIRROR_TOKEN=change-this-secret
# OWNER_MIRROR_SOURCE_ID=happy-song-local
OWNER_MIRROR_MODE=local
OWNER_MIRROR_CLOUD_URL=
OWNER_MIRROR_TOKEN=
OWNER_MIRROR_SOURCE_ID=happy-song-local
