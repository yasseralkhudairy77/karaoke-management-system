    "test:lc-report": "node tests/lc-work-reports.test.js",
    "test:lc-report-print-ui": "node tests/lc-report-print-ui.test.js",
    "test:package-unified": "node tests/package-unified-management.test.js",
    "test:contract": "node tests/contract-tests.js",
    "test:coverage": "node tests/action-coverage.test.js",
    "test:receipt-package-lc": "node tests/receipt-package-lc.test.js",
    "test:split-bill-summary": "node tests/split-bill-summary-ui.test.js",
    "test:inventory-status": "node tests/inventory-stock-status.test.js",
    "test:package-separation": "node tests/inventory-package-separation.test.js",
    "test:reset-inventory": "node tests/reset-inventory-stock.test.js",
    "test:universal-package-linking": "node tests/universal-package-linking.test.js",
    "test:promo-room": "node tests/promo-room-2plus1.test.js",
