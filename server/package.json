{
  "name": "happy-song-pos-server",
  "version": "1.0.0",
  "description": "Local-first Node.js Express server & PostgreSQL backend for Happy Song Karaoke Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "db:patch-stock-movements": "node scripts/patch-stock-movements-constraint.js",
    "db:migrate": "node scripts/migrate-sheets-to-postgres.js",
    "db:import-master-xlsx": "node scripts/import-master-xlsx.js",
    "db:validate": "node scripts/validate-migration-integrity.js",
    "db:clear-test-operational-data": "node scripts/clear-test-operational-data.js",
    "mirror:snapshot": "node scripts/export-owner-mirror-snapshot.js",
    "mirror:push": "node scripts/push-owner-mirror-snapshot.js",
    "mirror:cleanup-cloud": "node scripts/cleanup-owner-mirror-snapshots.js",
    "test": "npm run test:timezone && npm run test:mirror-rollover && npm run test:audit-report && npm run test:lc-report && npm run test:lc-report-print-ui && npm run test:package-unified && npm run test:receipt-package-lc && npm run test:split-bill-summary && npm run test:inventory-status && npm run test:package-separation && npm run test:coverage && npm run test:contract",
    "test:timezone": "node tests/timezone-boundary.test.js",
    "test:mirror-rollover": "node tests/owner-mirror-rollover.test.js",
