# Kode bridge yang tercermin dari C:\karaoke-tv-bridge (folder kerja yang dijalankan).
# Rahasia dan limbah TIDAK pernah masuk ke sini.

# Rahasia
.env
*.env
local.properties

# Limbah runtime
node_modules/
logs/
data/
*.log
cadangan-*/
bukti-*/

# Alat bantu lama
ngrok
ngrok.exe
ngrok.yml
ngrok-*.tgz

# Hasil build APK overlay (semerintah), dan bahan bangunan yang tidak perlu ikut repo
build/
dist/
assets/build/
assets/dist/
*.ap_
# APK overlay yang DIPAKAI RUNTIME adalah berkas jadi, bukan hasil build: inilah yang dipasang
# tombol "Pasang Peringatan" di POS. Karena itu di-commit dengan sengaja (dikecualikan di bawah,
# setelah pola di atas supaya urutannya benar).
*.apk
!assets/app-debug.apk
